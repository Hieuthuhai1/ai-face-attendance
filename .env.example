# Public (client-safe) — prefix NEXT_PUBLIC_ only
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key
NEXT_PUBLIC_APP_TZ=Asia/Ho_Chi_Minh
NEXT_PUBLIC_FACE_DEMO_BANNER=true

# Server-only — NEVER prefix with NEXT_PUBLIC_, never commit real values
# SUPABASE_SERVICE_ROLE_KEY=example-service-role-key
# Face Recognition Provider
# FACE_PROVIDER=mock                    # mock | aws-rekognition
# FACE_PROVIDER_API_KEY=                # AWS Access Key ID (for aws-rekognition)
# FACE_PROVIDER_SECRET_KEY=             # AWS Secret Access Key (for aws-rekognition)
# FACE_PROVIDER_REGION=ap-southeast-1   # AWS Region (ap-southeast-1 = Singapore)
# FACE_COLLECTION_ID=attendance-faces   # Rekognition Collection ID
# VERIFY_THRESHOLD=0.72                 # Face match threshold (0-1)
# REVIEW_BAND_LOW=0.60                  # Review band lower bound (0-1)
# ENROLL_BUCKET_TTL_HOURS=24
# PIN_FALLBACK_ENABLED=true
